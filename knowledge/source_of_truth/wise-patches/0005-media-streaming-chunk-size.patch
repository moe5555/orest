 def send_bytes_range_requests(
-    file_obj: BinaryIO, start: int, end: int, chunk_size: int = 10_000
+    file_obj: BinaryIO, start: int, end: int, chunk_size: int = 1024 * 1024
 ):
     """Send a file in chunks using Range Requests specification RFC7233
 
     `start` and `end` parameters are inclusive due to specification
+
+    Each chunk is one message through the ASGI send path, which costs far more
+    than the read itself, so throughput is governed by the chunk size rather
+    than by the disk. Browsers request video with an open-ended range, making
+    every seek in a multi-gigabyte file stream to end of file until the client
+    aborts, which is where the cost accumulates.
     """
     with file_obj as f:
         f.seek(start)
