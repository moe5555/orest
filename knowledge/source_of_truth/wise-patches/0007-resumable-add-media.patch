+    @property
+    def stored_ids(self) -> set[int]:
+        """Ids of the vectors saved to shard files, excluding the active shard."""
+        return {
+            vector_id
+            for vector_id, location in self._vector_id_to_shard_location.items()
+            if location != "current"
