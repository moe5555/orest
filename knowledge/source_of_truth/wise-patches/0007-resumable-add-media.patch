+def drop_media_with_stored_features(
+    project: WiseProject,
+    db_engine,
+    all_metadata: list[DatasetPayload],
+    feature_extractor_ids: dict[ModalityType, list],
+) -> list[DatasetPayload]:
+    """Remove media that already hold saved features from a selected extractor.
+
+    The extractors of a run process each media file together and their
+    features are saved together, so features from any one of them mark a file
+    as complete for that set. Features are recognised by their id in the
+    feature store rather than by their row in the database: rows remain after
+    an interruption that lost the features, and such files are extracted again.
+    """
+    done: set[int] = set()
+    with db_engine.connect() as conn:
+        for modality_type, feature_extractor_id_list in (
+            feature_extractor_ids.items()
+        ):
+            for feature_extractor_id in feature_extractor_id_list:
+                stored = FaissStore(
+                    modality_type, project.features_dir(feature_extractor_id)
+                ).stored_ids
+                if not stored:
+                    continue
+                stmt = sa.select(
+                    wise_db.vectors_table.c.id,
+                    wise_db.vectors_table.c.media_id,
+                ).where(
+                    wise_db.vectors_table.c.feature_extractor_id
+                    == feature_extractor_id
+                )
+                done.update(
+                    row.media_id for row in conn.execute(stmt) if row.id in stored
+                )
+
+    remaining = [x for x in all_metadata if x.id not in done]
+    if len(remaining) < len(all_metadata):
+        logger.info(
+            "Skipping %d of %d media files, which already hold features from %s",
+            len(all_metadata) - len(remaining),
+            len(all_metadata),
+            pprint.pformat(feature_extractor_ids),
+        )
+    return remaining
+
+
+@contextlib.contextmanager
+def discard_unsaved_features_on_error(
+    feature_stores: dict[ModalityType, dict[str, FaissStore]],
+):
+    """Keep the stores from saving features whose rows were rolled back.
+
+    A store saves its active shard when it is closed or garbage collected. After
+    an error the database rolls back the uncommitted rows, and the ids it hands
+    out next would collide with those features.
+    """
+    try:
+        yield
+    except BaseException:
+        for stores in feature_stores.values():
+            for store in stores.values():
+                store.discard_current_shard()
+        raise
 
 
